{$PUBLIC_HOST} {
	# SSE must stream: never compress or buffer text/event-stream
	@compressible not header Content-Type text/event-stream*
	encode @compressible gzip

	# proxy → control events stay on the internal edge network
	@internal path /internal/*
	respond @internal 404

	reverse_proxy control:3000 {
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# everything is same-origin: bundled fonts, SSE, screenshots and TTS audio all come from control
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
}
