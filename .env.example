# Vultr Serverless Inference (control layer only — never passed to sandboxes)
VULTR_INFERENCE_API_KEY=
AGENT_MODEL=
TTS_MODEL=
SAFETY_MODEL=
# Access code for any-URL beta runs
ACCESS_CODE=
# runsc on the Vultr VM, runc locally
SANDBOX_RUNTIME=runc
PUBLIC_ORIGIN=
PROXY_ADMIN_TOKEN=
CONTROL_EVENTS_TOKEN=
# Written by infra/deploy.sh if missing: <ip-with-dashes>.sslip.io
PUBLIC_HOST=
